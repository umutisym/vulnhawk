    print("=" * 50)
    return input("Yapılacak işlemi seçiniz: ").strip()


if __name__ == "__main__":
    try:
        while True:
            secim = menu()

            if secim.lower() in ("q", "quit", "exit", "0"):
                print("Çıkılıyor...")
                break
            elif secim == "1":
                _port_tara()
            elif secim == "2":
                hizli_zafiyet_taramasi()
            elif secim == "3":
                belirli_port_tara()
            else:
                print("[!] Geçersiz seçim, tekrar deneyin.")
    except KeyboardInterrupt:
        print("\n[!] Ctrl+C algılandı, çıkılıyor.")
        sys.exit(0)
